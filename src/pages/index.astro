---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  beneficios,
  comoFunciona,
  faqs,
  garantia,
  portfolioProjects,
  praQuemE,
  servicos,
  servicosComplementares,
  site,
  testimonials,
  whatsappUrl,
} from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const asset = (filePath: string) => `${base}${filePath.replace(/^\//, "")}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.seo.url}#organization`,
      name: site.name,
      url: site.seo.url,
      email: site.email,
      logo: `${site.seo.url.replace(/\/$/, "")}${site.assets.logo}`,
      sameAs: [site.instagram],
    },
    {
      "@type": "WebSite",
      "@id": `${site.seo.url}#website`,
      url: site.seo.url,
      name: site.name,
      publisher: { "@id": `${site.seo.url}#organization` },
      inLanguage: "pt-BR",
    },
    {
      "@type": "ArchitectureFirm",
      "@id": `${site.seo.url}#business`,
      name: site.name,
      image: `${site.seo.url.replace(/\/$/, "")}${site.assets.logo}`,
      telephone: `+${site.phoneLink}`,
      email: site.email,
      url: site.seo.url,
      priceRange: "$$$",
      sameAs: [site.instagram],
      areaServed: ["Uberlândia", "Goiânia", "Brasil"],
      address: {
        "@type": "PostalAddress",
        addressLocality: site.city,
        addressRegion: site.state,
        addressCountry: "BR",
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${site.seo.url}#faq`,
      mainEntity: faqs.map(([question, answer]) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
    ...testimonials.map((t) => ({
      "@type": "Review",
      itemReviewed: { "@id": `${site.seo.url}#business` },
      author: { "@type": "Person", name: t.name },
      reviewBody: t.quote,
    })),
  ],
};
---

<BaseLayout>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>

  <!-- Header & Navigation -->
  <header class="site-header">
    <div class="container header-inner">
      <a class="header-brand" href="#inicio" aria-label={`${site.name} — Início`}>
        <img src={asset(site.assets.logoWhite)} alt={site.name} width="156" height="40" />
      </a>
      <nav class="desktop-nav" aria-label="Navegação Principal">
        <a href="#servicos">Serviços</a>
        <a href="#como-funciona">Como funciona</a>
        <a href="#portfolio">Portfolio</a>
        <a href="#garantia">Sobre</a>
        <a href="#contato">Contato</a>
      </nav>
      <a class="header-cta-button" href="#contato">Solicitar Orçamento</a>
      <button
        class="hamburger"
        type="button"
        aria-expanded="false"
        aria-controls="mobileMenu"
        aria-label="Abrir menu de navegação"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <div class="mobile-menu-backdrop" data-close-menu></div>
    <div class="mobile-menu-panel">
      <div>
        <div class="mobile-menu-head">
          <img src={asset(site.assets.logoWhite)} alt={site.name} width="117" height="30" />
          <button class="mobile-menu-close" type="button" data-close-menu aria-label="Fechar menu">✕</button>
        </div>
        <nav class="mobile-nav" aria-label="Navegação Móvel">
          <a href="#servicos">Serviços</a>
          <a href="#como-funciona">Como funciona</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#garantia">Sobre</a>
          <a href="#contato">Contato</a>
        </nav>
      </div>
      <div class="mobile-menu-footer">
        <a class="mobile-cta-btn" href="#contato">Solicitar Orçamento</a>
      </div>
    </div>
  </div>

  <main id="conteudo">
    <!-- 01. HERO SECTION (Layered Overlapping Composition) -->
    <section class="hero-section" id="inicio">
      <div class="hero-composition">
        <!-- Layer 1: Left White Card with Logo, H1, Lead, Form & Bullets -->
        <div class="hero-card">
          <div class="hero-card-brand">
            <img src={asset(site.assets.logo1)} alt={site.name} width="168" height="43" />
          </div>
          <h1 class="hero-card-title">
            CRIAMOS <i><span class="cinza">LUGARES</span></i><br />
            <i><span class="cinza">QUE CONTAM A</span></i><br />
            <i><span class="cinza">SUA HISTÓRIA.</span></i>
          </h1>
          <p class="hero-card-desc">
            <span class="cinza">Projetos arquitetônicos e</span> <strong>design de interiores com planejamento estratégico e transparência total.</strong> <span class="cinza">Viabilidade financeira mapeada antes da obra, cronograma com marcos definidos.</span> <strong>Do conceito à entrega.</strong>
          </p>

          <form class="koplan-form" action={whatsappUrl} target="_blank" method="GET">
            <div class="form-group">
              <label class="form-label" for="hero-nome">NOME <span class="required-star">*</span></label>
              <input class="form-input" type="text" id="hero-nome" name="nome" placeholder="Seu Nome Completo" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="hero-email">E-MAIL <span class="required-star">*</span></label>
              <input class="form-input" type="email" id="hero-email" name="email" placeholder="Seu E-mail" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="hero-whatsapp">SEU WHATSAPP COM DDD <span class="required-star">*</span></label>
              <div class="phone-input-wrap">
                <div class="phone-country-badge" aria-hidden="true">
                  <svg class="country-flag-svg" xmlns="http://www.w3.org/2000/svg" width="18" height="13" viewBox="0 0 720 504">
                    <rect width="720" height="504" fill="#009c3b" rx="20"/>
                    <polygon points="360,42 672,252 360,462 48,252" fill="#ffdf00"/>
                    <circle cx="360" cy="252" r="126" fill="#002776"/>
                    <path d="M234,252 a126,126 0 0,0 252,0" fill="none" stroke="#ffffff" stroke-width="12.6"/>
                  </svg>
                  <span class="country-arrow">▾</span>
                </div>
                <input class="form-input phone-input" type="tel" id="hero-whatsapp" name="whatsapp" placeholder="(11) 96123-4567" required />
              </div>
            </div>
            <button class="btn-submit" type="submit">SOLICITAR ORÇAMENTO</button>
          </form>

          <ul class="hero-bullets">
            <li class="hero-bullet-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M13.4267 4.28751C13.0761 3.45084 12.5661 2.69036 11.9251 2.04845C11.286 1.40544 10.5269 0.894199 9.69076 0.543764C8.83422 0.183028 7.91392 -0.00188286 6.98451 1.44539e-05H6.95326C6.00795 0.00470195 5.09389 0.192202 4.23295 0.560952C3.404 0.914982 2.65197 1.42713 2.01889 2.06876C1.38409 2.70922 0.879938 3.46705 0.534513 4.30001C0.175947 5.16621 -0.00574178 6.09537 0.000138292 7.03283C0.00482579 8.1172 0.264201 9.19376 0.748576 10.1563V12.5313C0.748576 12.9281 1.07045 13.25 1.46576 13.25H3.83764C4.80463 13.738 5.87171 13.9947 6.95483 14H6.98764C7.92201 14 8.8267 13.8188 9.67983 13.4641C10.5117 13.1178 11.268 12.6125 11.9064 11.9766C12.5501 11.3375 13.0564 10.5906 13.4111 9.75783C13.7783 8.89533 13.9658 7.97814 13.9705 7.03126C13.9736 6.0797 13.7892 5.15626 13.4267 4.28751ZM3.86576 7.75001C3.45326 7.75001 3.11733 7.41408 3.11733 7.00001C3.11733 6.58595 3.45326 6.25001 3.86576 6.25001C4.27826 6.25001 4.6142 6.58595 4.6142 7.00001C4.6142 7.41408 4.27983 7.75001 3.86576 7.75001ZM6.98451 7.75001C6.57201 7.75001 6.23608 7.41408 6.23608 7.00001C6.23608 6.58595 6.57201 6.25001 6.98451 6.25001C7.39701 6.25001 7.73295 6.58595 7.73295 7.00001C7.73295 7.41408 7.39701 7.75001 6.98451 7.75001ZM10.1033 7.75001C9.69076 7.75001 9.35483 7.41408 9.35483 7.00001C9.35483 6.58595 9.69076 6.25001 9.69076 6.25001C10.5158 6.25001 10.8517 6.58595 10.8517 7.00001C10.8517 7.41408 10.5158 7.75001 10.1033 7.75001Z" fill="#292929"/></svg>
              <span>RETORNO EM ATÉ 1 DIA ÚTIL.</span>
            </li>
            <li class="hero-bullet-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M10 19C14.9707 19 19 14.9707 19 10C19 5.0293 14.9707 1 10 1C5.0293 1 1 5.0293 1 10C1 14.9707 5.0293 19 10 19Z" stroke="#292929" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 10H19" stroke="#292929" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.9999 19C11.988 19 13.5999 14.9707 13.5999 10C13.5999 5.0293 11.988 1 9.9999 1C8.0118 1 6.3999 5.0293 6.3999 10C6.3999 14.9707 8.0118 19 9.9999 19Z" stroke="#292929" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>ATENDIMENTO NACIONAL COM PROCESSO DIGITAL.</span>
            </li>
          </ul>
        </div>

        <!-- Layer 2: Right Hero Visual Stage with overlapping layers -->
        <div class="hero-stage">
          <div class="hero-image-frame">
            <!-- White 'K' Badge with Dark Rounded Backing in Top Right of Image -->
            <div class="hero-watermark-k-badge" aria-hidden="true">
              <img
                src={asset(site.assets.logoSymbol)}
                alt="K"
                width="22"
                height="22"
              />
            </div>
            <img
              class="hero-img-desktop"
              src={asset(site.assets.heroDesktop)}
              alt="Projetos arquitetônicos de alto padrão Koplan"
              width="922"
              height="1103"
              fetchpriority="high"
            />
            <img
              class="hero-img-mobile"
              src={asset(site.assets.heroMobile)}
              alt="Projetos arquitetônicos Koplan"
              width="715"
              height="490"
            />

            <!-- Layer 3: Floating Protocol Badge on Top of Image -->
            <div class="hero-protocol-badge">
              <img
                class="hero-protocol-thumb"
                src={asset(site.assets.heroBadgeThumbnail)}
                alt=""
                width="257"
                height="255"
              />
              <p class="hero-protocol-text">
                <strong>Arquitetura bem feita</strong> <span class="cinza">não é</span><br />
                <span class="cinza">diferencial. É protocolo.</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02. SECTION: PRA QUEM É -->
    <section class="section-pra-quem" id="pra-quem">
      <div class="pra-quem-grid">
        <div class="up">
          <div class="pra-quem-head">
            <p class="section-tag">{praQuemE.sectionTitle}</p>
            <h2 class="section-title-kiona">
              <i><span class="cinza">ARQUITETURA</span></i> PARA QUEM <i><span class="cinza">VALORIZA PROCESSO,</span></i> TEMPO E RESULTADO.
            </h2>
          </div>

          <div class="pra-quem-visuals">
            <div class="pra-quem-images-row">
              <img class="pra-quem-img-1" src={asset(site.assets.kitchenPraQuem)} alt="Cozinha planejada Koplan" width="426" height="624" />
              <div class="pra-quem-leisure-col">
                <img class="pra-quem-img-2" src={asset(site.assets.leisurePraQuem)} alt="Área de lazer Koplan" width="425" height="493" />
                <div class="pra-quem-badge">
                  <img class="pra-quem-badge-icon" src={asset(site.assets.logoSymbol)} alt="" width="33" height="42" />
                  <p class="pra-quem-badge-title">
                    <strong>{praQuemE.badge.bold1}</strong> <span class="cinza">{praQuemE.badge.gray}</span> <strong>{praQuemE.badge.bold2}</strong>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="pra-quem-side up1">
          <p class="pra-quem-subhead"><span class="cinza">A</span> KOPLAN <span class="cinza">ATENDE QUEM:</span></p>

          <ul class="pra-quem-list">
            {praQuemE.items.map((item) => (
              <li class="pra-quem-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 29 29" fill="none">
                  <path d="M14.5 0C22.5081 0 29 6.49187 29 14.5C29 22.5081 22.5081 29 14.5 29C6.49187 29 0 22.5081 0 14.5C0 6.49187 6.49187 0 14.5 0ZM22.126 8.68457C21.7372 8.30413 21.1153 8.30405 20.7266 8.68457L11.9941 17.2344C11.6054 17.6148 10.9834 17.6149 10.5947 17.2344L7.27344 13.9824C6.8847 13.6019 6.26276 13.6019 5.87402 13.9824L5.72949 14.123C5.32903 14.5152 5.329 15.1606 5.72949 15.5527L10.5947 20.3154C10.9834 20.6959 11.6054 20.6959 11.9941 20.3154L22.2705 10.2549C22.6707 9.86279 22.6707 9.21826 22.2705 8.82617L22.126 8.68457Z" fill="#292929"/>
                </svg>
                <span>
                  {item.bold && <strong>{item.bold} </strong>}
                  {item.gray && <span class="cinza">{item.gray} </span>}
                  {item.grayEnd && <span class="cinza">{item.grayEnd}</span>}
                </span>
              </li>
            ))}
          </ul>

          <p class="pra-quem-quote">
            <span class="cinza">{praQuemE.quote.gray1}<br /><br />{praQuemE.quote.gray2} </span>
            <strong>{praQuemE.quote.bold}</strong>
          </p>
        </div>
      </div>
    </section>

    <!-- 03. SECTION: BENEFÍCIOS & SERVIÇOS (dark + overlapping white sheet) -->
    <section class="section-beneficios-servicos" id="beneficios">
      <div class="container">
        <!-- White overlapping sheet with header, image cards + quote -->
        <div class="beneficios-sheet up">
          <div class="beneficios-sheet-grid">
            <div class="beneficios-sheet-head">
              <p class="section-tag">{beneficios.sectionTitle}</p>
              <h2 class="section-title-kiona">
                VOCÊ <i><span class="cinza">NÃO PRECISA ENTENDER</span></i> DE OBRA. <i><span class="cinza">PRECISA</span></i> DE <i><span class="cinza">QUEM ENTENDA</span></i> POR VOCÊ.
              </h2>
            </div>

            {beneficios.cards.map((card, idx) => (
              card.theme === "dark" ? (
                <div class={`beneficio-dark-card up${(idx % 3) + 1}`} style={`background-image: url('${asset(card.bgImage)}')`} role="img" aria-label={card.bgImageAlt}>
                  <h3 class="beneficio-dark-card-title">{card.title}</h3>
                  <ul class="beneficio-dark-list">
                    {card.items.map((item) => (
                      <li class="beneficio-dark-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="12" viewBox="0 0 16 12" fill="none">
                          <path d="M5.99012 10.9019C5.59959 11.2924 4.96643 11.2924 4.5759 10.9019L0.290114 6.61609C-0.10041 6.22557 -0.0950163 5.58701 0.295508 5.19648C0.686032 4.80596 1.32459 4.80057 1.71511 5.19109L4.5759 8.05188C4.96643 8.4424 5.59959 8.4424 5.99011 8.05188L13.7509 0.291092C14.1414 -0.0994327 14.78 -0.0940398 15.1705 0.296485C15.561 0.687009 15.5664 1.32557 15.1759 1.71609L5.99012 10.9019Z" fill="#FFFFFF"/>
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <div class={`beneficio-image-card up${(idx % 3) + 1}`}>
                  <h3 class="beneficio-card-title">{card.title}</h3>
                  <ul class="beneficio-list">
                    {card.items.map((item) => (
                      <li class="beneficio-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="12" viewBox="0 0 16 12" fill="none">
                          <path d="M5.99012 10.9019C5.59959 11.2924 4.96643 11.2924 4.5759 10.9019L0.290114 6.61609C-0.10041 6.22557 -0.0950163 5.58701 0.295508 5.19648C0.686032 4.80596 1.32459 4.80057 1.71511 5.19109L4.5759 8.05188C4.96643 8.4424 5.59959 8.4424 5.99011 8.05188L13.7509 0.291092C14.1414 -0.0994327 14.78 -0.0940398 15.1705 0.296485C15.561 0.687009 15.5664 1.32557 15.1759 1.71609L5.99012 10.9019Z" fill={card.iconFill}/>
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                  <img class="beneficio-image-card-photo" src={asset(card.image)} alt={card.imageAlt} loading="lazy" width="560" height="420" style={card.image.includes("sala") ? "aspect-ratio: 414 / 364" : "aspect-ratio: 414 / 322"} />
                </div>
              )
            ))}
          </div>

          <p class="beneficios-quote">
            “{beneficios.quote.pre}<i><span class="cinza">{beneficios.quote.italic}</span></i><span class="cinza">{beneficios.quote.post}</span>”
          </p>
        </div>

        <!-- Dark block below the sheet -->
        <div class="beneficios-dark-block">
          <!-- Serviços Block ("O QUE ENTREGAMOS:") -->
          <div class="servicos-header-wrapper up" id="servicos">
            <p class="section-tag">{servicos.sectionTitle}</p>
            <h2 class="section-title-kiona servicos-title">O QUE <i><span class="cinza">ENTREGAMOS:</span></i></h2>
          </div>

          <div class="servicos-grid">
            {servicos.cards.map((card, idx) => (
              <article class={`servico-card servico-card-${idx + 1} up${(idx % 2) + 1}`} style={`background-image: url('${asset(card.bgImage)}')`}>
                <div class="servico-card-top">
                  <span class="servico-hover-pill">{servicos.hoverPrompt}</span>
                  <span class="servico-arrow-btn" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                  </span>
                </div>
                <div class="servico-card-body">
                  <div class="servico-tags">
                    {card.tags.map((tag) => (
                      <span class="servico-tag">{tag}</span>
                    ))}
                  </div>
                  <h3 class="servico-card-title">{card.title}</h3>
                  <p class="servico-card-sub">{card.subtitle}</p>
                  <p class="servico-card-desc">{card.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 04. SECTION: COMO FUNCIONA (PROCESS ACCORDION + SIDE IMAGE) -->
    <section class="section-como-funciona" id="como-funciona">
      <div class="container">
        <div class="como-funciona-header up">
          <p class="section-tag">{comoFunciona.sectionTitle}</p>
          <h2 class="section-title-kiona">ETAPAS DETALHADAS DO<br />PROCESSO KOPLAN:</h2>
        </div>

        <div class="como-funciona-row">
          <div class="process-accordion-list">
            {comoFunciona.steps.map((step, idx) => (
              <details class="process-accordion-item up" open={idx === 0} name="processo-koplan">
                <summary class="process-accordion-summary" data-step={step.number}>
                  <div class="process-title-group">
                    <h3 class="process-title">{step.title}</h3>
                    <p class="process-tagline">{step.tagline}</p>
                  </div>
                </summary>
                <div class="process-body">
                  <p>{step.description}</p>
                  {step.extra && <p class="process-body-extra">{step.extra}</p>}
                </div>
              </details>
            ))}
          </div>

          <div class="como-funciona-visual up1">
            <div class="como-funciona-image-frame">
              <img
                class="como-funciona-img"
                src={asset(comoFunciona.sideImage)}
                alt={comoFunciona.sideImageAlt}
                loading="lazy"
                width="768"
                height="908"
              />
              <div class="como-funciona-side-card">
                <div class="como-side-carousel" data-carousel>
                  {comoFunciona.sideCard.images.map((img, idx) => (
                    <img
                      class={`como-side-slide${idx === 0 ? " active" : ""}`}
                      src={asset(img.src)}
                      alt={img.alt}
                      loading="lazy"
                      width="276"
                      height="210"
                    />
                  ))}
                </div>
                <p class="como-side-card-text">{comoFunciona.sideCard.text}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="como-funciona-cta up">
          <a class="btn-submit como-cta-btn" href="#contato">SOLICITAR ORÇAMENTO</a>
          <ul class="hero-bullets como-cta-bullets">
            {comoFunciona.ctaBullets.map((bullet) => (
              <li class="hero-bullet-item"><span>{bullet}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 05. SECTION: SERVIÇOS COMPLEMENTARES -->
    <section class="section-complementares">
      <div class="container">
        <div class="complementares-header up">
          <p class="section-tag">{servicosComplementares.sectionTitle}</p>
          <h2 class="section-title-kiona">
            VOCÊ PODE <i><span class="cinza">CONTRATAR SEPARADAMENTE</span></i>:
          </h2>
        </div>

        <div class="complementares-row">
          <img class="complementares-photo" src={asset(site.assets.kitchenLarge)} alt="Cozinha grande e moderna" loading="lazy" width="713" height="404" />
          <div class="complementares-grid">
            {servicosComplementares.items.map((item, idx) => (
              <div class={`complementar-card up${(idx % 3) + 1}`}>
