                <div class="portfolio-slide-media">
                  {project.imagesDesktop.map((img, imgIdx) => (
                    <img
                      class={`portfolio-main${imgIdx === 0 ? " active" : ""}`}
                      src={asset(img)}
                      alt={`${project.name} — foto ${imgIdx + 1}`}
                      loading={idx === 0 && imgIdx === 0 ? "eager" : "lazy"}
                      width="1140"
                      height="640"
                      data-portfolio-main={imgIdx}
                    />
                  ))}
                  <div class="portfolio-slide-top">
                    <h3 class="portfolio-project-title">PORTFÓLIO<br /><i>KOPLAN</i></h3>
